# Verilator Makefile for the cvwsoc whole-system simulation

SHELL := /bin/bash
.PHONY: \
	all linux uboot run-cvwsoc qemu qemu-preload runcmd-cvwsoc clean \
	cleantb \
	gen-cvwsoc-linux-preload gen-cvwsoc-uboot-preload gen-cvwsoc-sd-image \
	gen-cvwsoc-linux-fast-preload \
	qemu-linux-preload qemu-uboot-preload qemu-linux qemu-uboot \
	qemu-linux-fast qemu-linux-fast-preload qemu-preload-linux-fast \
	run-cvwsoc-linux run-cvwsoc-uboot runcmd-cvwsoc-linux runcmd-cvwsoc-uboot \
	run-cvwsoc-linux-fast sim-fast sim-fast-uboot \
	FORCE
.DELETE_ON_ERROR:

# If cleanup is mixed with a build/run goal, keep this top-level make serial.
# The recursive Verilator C++ build still receives the jobserver from -j.
ifneq ($(filter clean cleantb,$(MAKECMDGOALS)),)
ifneq ($(filter-out clean cleantb,$(MAKECMDGOALS)),)
.NOTPARALLEL:
endif
endif


ifneq ($(filter sim-fast sim-fast-uboot,$(MAKECMDGOALS)),)
PERF_CPU ?= 6
ifeq ($(RV32),0)
$(error sim-fast and sim-fast-uboot require RV32=1)
endif
RV32 ?= 1
CONFIG ?= fpgagenesys2rv32w64soc
CPUSETTINGS ?= taskset -c $(PERF_CPU)
endif

CPUSETTINGS ?=

# prefix for Verilator. E.g. 'taskset -c 2'

WALLY ?= $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../..)
export WALLY
BOOL_TRUE := 1 yes YES true TRUE
RV32 ?= 0
CVWSOC_RV32 := $(filter $(BOOL_TRUE),$(RV32))
SDHCI ?= 0
DMA ?= 0
I2S ?= 0
BOOTROM ?= 0
CVWSOC_BOOTROM := $(filter $(BOOL_TRUE),$(BOOTROM))
# Enable SDHCI with bootrom boot (can't do RAM preload)
CVWSOC_SIM_SDHCI := $(if $(CVWSOC_BOOTROM),1,$(filter $(BOOL_TRUE),$(SDHCI)))
CVWSOC_SIM_DMA := $(filter $(BOOL_TRUE),$(DMA))
CVWSOC_SIM_I2S := $(filter $(BOOL_TRUE),$(I2S))
WALLYCONF ?= fpgagenesys2soc
CONFIG ?= $(if $(CVWSOC_RV32),fpgagenesys2rv32soc,$(WALLYCONF))
CVWSOC_SIM_AXI_RAM ?= $(if $(CVWSOC_SIM_SDHCI),0,1)
CVWSOC_CONFIG_RV32 := $(findstring rv32,$(CONFIG))
CVWSOC_CONFIG_RV32W64 := $(findstring rv32w64,$(CONFIG))
CVWSOC_XLEN ?= $(if $(or $(CVWSOC_RV32),$(CVWSOC_CONFIG_RV32)),32,64)
CVWSOC_BUS_WIDTH ?= $(if $(CVWSOC_CONFIG_RV32W64),64,$(CVWSOC_XLEN))
CVWSOC_WORD_BYTES ?= $(if $(filter 32,$(CVWSOC_BUS_WIDTH)),4,8)
VERILATOR ?= verilator
VERILATOR_DIR := $(WALLY)/sim/verilator
COPIED_ROOT := $(WALLY)/fpga/src/CopiedFiles_do_not_add_to_repo
PULP_ROOT := $(COPIED_ROOT)/pulp
PULP_AXI_ROOT := $(PULP_ROOT)/axi
PULP_AXI_STREAM_ROOT := $(WALLY)/addins/pulp/axi_stream
PULP_COMMON_CELLS_ROOT := $(PULP_ROOT)/common_cells
PULP_REGISTER_INTERFACE_ROOT := $(PULP_ROOT)/register_interface
SDHCI_ROOT := $(COPIED_ROOT)/sdhci/hw
IDMA_ROOT := $(PULP_ROOT)/idma

CVWSOC_DEPLOY_ROOT ?= /yocto/fpga/kas-cvwsoc/build/tmp/deploy/images
CVWSOC_MACHINE ?= $(if $(CVWSOC_RV32),cvwsoc-virt32,cvwsoc-virt)
CVWSOC_DEPLOY_DIR ?= $(CVWSOC_DEPLOY_ROOT)/$(CVWSOC_MACHINE)
CVWSOC_PRELOAD_ROOT ?= $(VERILATOR_DIR)/preload/cvwsoc
CVWSOC_PRELOAD_DIR ?= $(CVWSOC_PRELOAD_ROOT)/$(CVWSOC_MACHINE)
CVWSOC_DTS_SRC ?= $(WALLY)/linux/devicetree/$(if $(filter 32,$(CVWSOC_XLEN)),wally-virt32soc.dts,wally-virtsoc.dts)
CVWSOC_ORIG_DTB ?= $(CVWSOC_DEPLOY_DIR)/$(if $(CVWSOC_RV32),wally-virt32soc.dtb,wally-virtsoc.dtb)
CVWSOC_FW_JUMP_BIN ?= $(CVWSOC_DEPLOY_DIR)/fw_jump.bin
CVWSOC_UBOOT_BIN ?= $(CVWSOC_DEPLOY_DIR)/u-boot.bin
CVWSOC_UBOOT_DTB ?= $(CVWSOC_DEPLOY_DIR)/$(if $(CVWSOC_RV32),cvwsoc-virt32.dtb,cvwsoc-virt.dtb)
RISCV_GCC_BIN ?= riscv64-unknown-elf-gcc
RISCV_OBJCOPY_BIN ?= riscv64-unknown-elf-objcopy
CVWSOC_STUB_MARCH ?= $(if $(filter 32,$(CVWSOC_XLEN)),rv32imac,rv64imac)
CVWSOC_STUB_MABI ?= $(if $(filter 32,$(CVWSOC_XLEN)),ilp32,lp64)
CVWSOC_UBOOT_STUB_ELF ?= $(CVWSOC_PRELOAD_DIR)/uboot-replacement-stub-rv$(CVWSOC_XLEN).elf
CVWSOC_UBOOT_STUB_BIN ?= $(CVWSOC_PRELOAD_DIR)/uboot-replacement-stub-rv$(CVWSOC_XLEN).bin

IMAGE_KIND ?= $(or $(IMAGE_TYPE),tiny)
INITRD_EXT2 ?= 0
CVWSOC_USE_EXT2 := $(filter $(BOOL_TRUE),$(INITRD_EXT2))
CVWSOC_IMAGE_NAME := $(if $(filter full FULL doom DOOM,$(IMAGE_KIND)),doom,tiny)
CVWSOC_INITRD_EXT := $(if $(CVWSOC_USE_EXT2),ext2,cpio)

CVWSOC_LINUX_BOOTROM_BIN ?= $(CVWSOC_PRELOAD_DIR)/bootmem-cvwsoc-linux.bin
CVWSOC_LINUX_EXT_RAM_BIN ?= $(CVWSOC_PRELOAD_DIR)/ram-cvwsoc-linux.bin
CVWSOC_UBOOT_BOOTROM_BIN ?= $(CVWSOC_PRELOAD_DIR)/bootmem-cvwsoc-uboot.bin
CVWSOC_UBOOT_EXT_RAM_BIN ?= $(CVWSOC_PRELOAD_DIR)/ram-cvwsoc-uboot.bin
CVWSOC_LINUX_RAW_BOOTROM_BIN ?= $(CVWSOC_PRELOAD_DIR)/bootmemGDB-cvwsoc-linux.bin
CVWSOC_LINUX_RAW_EXT_RAM_BIN ?= $(CVWSOC_PRELOAD_DIR)/ramGDB-cvwsoc-linux.bin
CVWSOC_UBOOT_RAW_BOOTROM_BIN ?= $(CVWSOC_PRELOAD_DIR)/bootmemGDB-cvwsoc-uboot.bin
CVWSOC_UBOOT_RAW_EXT_RAM_BIN ?= $(CVWSOC_PRELOAD_DIR)/ramGDB-cvwsoc-uboot.bin

CVWSOC_LINUX_QEMU_KERNEL ?= $(CVWSOC_PRELOAD_DIR)/linux-qemu-cvwsoc-linux.bin
CVWSOC_UBOOT_QEMU_KERNEL ?= $(CVWSOC_PRELOAD_DIR)/linux-qemu-cvwsoc-uboot.bin
CVWSOC_LINUX_FAST_QEMU_KERNEL ?= $(CVWSOC_PRELOAD_DIR)/linux-qemu-cvwsoc-linux-fast.bin
CVWSOC_LINUX_QEMU_INITRD ?= $(CVWSOC_PRELOAD_DIR)/initrd-qemu-cvwsoc-linux.$(CVWSOC_INITRD_EXT)
CVWSOC_UBOOT_QEMU_INITRD ?= $(CVWSOC_PRELOAD_DIR)/initrd-qemu-cvwsoc-uboot.$(CVWSOC_INITRD_EXT)
CVWSOC_LINUX_FAST_QEMU_ROOTFS ?= $(CVWSOC_PRELOAD_DIR)/rootfs-qemu-cvwsoc-linux-fast.jffs2
CVWSOC_LINUX_QEMU_DTS ?= $(CVWSOC_PRELOAD_DIR)/wally-virtsoc-linux.dts
CVWSOC_UBOOT_QEMU_DTS ?= $(CVWSOC_PRELOAD_DIR)/wally-virtsoc-uboot.dts
CVWSOC_LINUX_FAST_QEMU_DTS ?= $(CVWSOC_PRELOAD_DIR)/wally-virtsoc-linux-fast.dts
CVWSOC_LINUX_QEMU_DTB ?= $(CVWSOC_PRELOAD_DIR)/wally-virtsoc-linux.dtb
CVWSOC_UBOOT_QEMU_DTB ?= $(CVWSOC_PRELOAD_DIR)/wally-virtsoc-uboot.dtb
CVWSOC_LINUX_FAST_QEMU_DTB ?= $(CVWSOC_PRELOAD_DIR)/wally-virtsoc-linux-fast.dtb
CVWSOC_LINUX_QEMU_ASSETS := $(CVWSOC_LINUX_QEMU_KERNEL) $(CVWSOC_LINUX_QEMU_INITRD) $(CVWSOC_LINUX_QEMU_DTS) $(CVWSOC_LINUX_QEMU_DTB)
CVWSOC_UBOOT_QEMU_ASSETS := $(CVWSOC_UBOOT_QEMU_KERNEL) $(CVWSOC_UBOOT_QEMU_INITRD) $(CVWSOC_UBOOT_QEMU_DTS) $(CVWSOC_UBOOT_QEMU_DTB)
CVWSOC_LINUX_FAST_QEMU_ASSETS := $(CVWSOC_LINUX_FAST_QEMU_KERNEL) $(CVWSOC_LINUX_FAST_QEMU_ROOTFS) $(CVWSOC_LINUX_FAST_QEMU_DTS) $(CVWSOC_LINUX_FAST_QEMU_DTB)
CVWSOC_LINUX_PRELOAD_BINS := $(CVWSOC_LINUX_BOOTROM_BIN) $(CVWSOC_LINUX_EXT_RAM_BIN)
CVWSOC_UBOOT_PRELOAD_BINS := $(CVWSOC_UBOOT_BOOTROM_BIN) $(CVWSOC_UBOOT_EXT_RAM_BIN)
CVWSOC_LINUX_FAST_BOOTROM_BIN ?= $(CVWSOC_PRELOAD_DIR)/bootmem-cvwsoc-linux-fast.bin
CVWSOC_LINUX_FAST_EXT_RAM_BIN ?= $(CVWSOC_PRELOAD_DIR)/ram-cvwsoc-linux-fast.bin
CVWSOC_LINUX_FAST_RAW_BOOTROM_BIN ?= $(CVWSOC_PRELOAD_DIR)/bootmemGDB-cvwsoc-linux-fast.bin
CVWSOC_LINUX_FAST_RAW_EXT_RAM_BIN ?= $(CVWSOC_PRELOAD_DIR)/ramGDB-cvwsoc-linux-fast.bin
CVWSOC_LINUX_FAST_PRELOAD_BINS := $(CVWSOC_LINUX_FAST_BOOTROM_BIN) $(CVWSOC_LINUX_FAST_EXT_RAM_BIN)
CVWSOC_LINUX_QEMU_CFG := $(CVWSOC_PRELOAD_DIR)/.cvwsoc-linux-qemu.cfg
CVWSOC_UBOOT_QEMU_CFG := $(CVWSOC_PRELOAD_DIR)/.cvwsoc-uboot-qemu.cfg
CVWSOC_LINUX_FAST_QEMU_CFG := $(CVWSOC_PRELOAD_DIR)/.cvwsoc-linux-fast-qemu.cfg
CVWSOC_LINUX_PRELOAD_CFG := $(CVWSOC_PRELOAD_DIR)/.cvwsoc-linux-preload.cfg
CVWSOC_UBOOT_PRELOAD_CFG := $(CVWSOC_PRELOAD_DIR)/.cvwsoc-uboot-preload.cfg
CVWSOC_LINUX_FAST_PRELOAD_CFG := $(CVWSOC_PRELOAD_DIR)/.cvwsoc-linux-fast-preload.cfg

CVWSOC_LINUX_INITRD_EXT2 ?= $(shell ls -1t $(CVWSOC_DEPLOY_DIR)/cvwsoc-image-$(CVWSOC_IMAGE_NAME)-*.rootfs.ext2 2>/dev/null | head -n1)
CVWSOC_LINUX_INITRD_CPIO_GZ ?= $(shell ls -1t $(CVWSOC_DEPLOY_DIR)/cvwsoc-image-$(CVWSOC_IMAGE_NAME)-*.rootfs.cpio.gz 2>/dev/null | head -n1)
CVWSOC_LINUX_INITRD_CPIO ?= $(shell ls -1t $(CVWSOC_DEPLOY_DIR)/cvwsoc-image-$(CVWSOC_IMAGE_NAME)-*.rootfs.cpio 2>/dev/null | head -n1)
CVWSOC_LINUX_INITRD_SRC ?= $(if $(CVWSOC_USE_EXT2),$(CVWSOC_LINUX_INITRD_EXT2),$(or $(CVWSOC_LINUX_INITRD_CPIO),$(CVWSOC_LINUX_INITRD_CPIO_GZ)))
CVWSOC_LINUX_FAST_ROOTFS_SRC ?= $(shell ls -1t $(CVWSOC_DEPLOY_DIR)/cvwsoc-image-$(CVWSOC_IMAGE_NAME)-*.rootfs.jffs2 $(CVWSOC_DEPLOY_DIR)/cvwsoc-image-$(CVWSOC_IMAGE_NAME)-*.rootfs-*.jffs2 2>/dev/null | head -n1)
CVWSOC_LINUX_KERNEL_SRC ?= $(if $(wildcard $(CVWSOC_DEPLOY_DIR)/Image.lz4.orig),$(CVWSOC_DEPLOY_DIR)/Image.lz4.orig,$(if $(wildcard $(CVWSOC_DEPLOY_DIR)/Image.lz4),$(CVWSOC_DEPLOY_DIR)/Image.lz4,$(if $(wildcard $(CVWSOC_DEPLOY_DIR)/Image),$(CVWSOC_DEPLOY_DIR)/Image,$(CVWSOC_DEPLOY_DIR)/linux.bin)))

CVWSOC_SD_IMAGE_FOLDER ?= addins/cvwsoc/sdhci/image
# Destination image opened by the SD model.  CVWSOC_SD_IMAGE_SRC below selects
# the Yocto deploy artifact used to generate it.
CVWSOC_SD_IMAGE ?= $(CVWSOC_SD_IMAGE_FOLDER)/imagesd.bin
CVWSOC_SD_IMAGE_WIC ?= $(shell ls -1t $(CVWSOC_DEPLOY_DIR)/cvwsoc-image-$(CVWSOC_IMAGE_NAME)-*.rootfs.wic 2>/dev/null | head -n1)
CVWSOC_SD_IMAGE_WIC_GZ ?= $(shell ls -1t $(CVWSOC_DEPLOY_DIR)/cvwsoc-image-$(CVWSOC_IMAGE_NAME)-*.rootfs.wic.gz 2>/dev/null | head -n1)
CVWSOC_SD_IMAGE_SRC ?= $(or $(CVWSOC_SD_IMAGE_WIC),$(CVWSOC_SD_IMAGE_WIC_GZ))
CVWSOC_SD_IMAGE_ENABLE ?= $(if $(CVWSOC_SIM_SDHCI),1,0)
CVWSOC_SD_IMAGE_DEPS := $(if $(filter $(BOOL_TRUE),$(CVWSOC_SD_IMAGE_ENABLE)),$(CVWSOC_SD_IMAGE))
SD_IMAGE := $(CVWSOC_SD_IMAGE)

CVWSOC_VERILATOR_SDHCI_DTS ?= $(CVWSOC_PRELOAD_DIR)/wally-virt$(if $(filter 32,$(CVWSOC_XLEN)),32,)soc-verilator-sdhci.dts
CVWSOC_VERILATOR_SDHCI_DTB ?= $(CVWSOC_PRELOAD_DIR)/wally-virt$(if $(filter 32,$(CVWSOC_XLEN)),32,)soc-verilator-sdhci.dtb
CVWSOC_VERILATOR_DTB ?= $(if $(filter $(BOOL_TRUE),$(SDHCI)),$(CVWSOC_VERILATOR_SDHCI_DTB))
CVWSOC_LINUX_RUN_EXT_RAM_BIN ?= $(if $(CVWSOC_VERILATOR_DTB),$(CVWSOC_PRELOAD_DIR)/ram-cvwsoc-linux-run.bin,$(CVWSOC_LINUX_EXT_RAM_BIN))
CVWSOC_UBOOT_RUN_EXT_RAM_BIN ?= $(if $(CVWSOC_VERILATOR_DTB),$(CVWSOC_PRELOAD_DIR)/ram-cvwsoc-uboot-run.bin,$(CVWSOC_UBOOT_EXT_RAM_BIN))
CVWSOC_LINUX_RUN_PRELOAD_BINS := $(CVWSOC_LINUX_BOOTROM_BIN) $(CVWSOC_LINUX_RUN_EXT_RAM_BIN)
CVWSOC_UBOOT_RUN_PRELOAD_BINS := $(CVWSOC_UBOOT_BOOTROM_BIN) $(CVWSOC_UBOOT_RUN_EXT_RAM_BIN)

CVWSOC_LINUX_BOOTARGS_BASE ?= earlycon=uart8250,mmio,0x10000000 console=ttyS0,115200 ignore_loglevel loglevel=8 rdinit=/bin/busybox.nosuid -- sh
CVWSOC_LINUX_BOOTARGS_EXT2 ?= earlycon=uart8250,mmio,0x10000000 console=ttyS0,115200 ignore_loglevel loglevel=8 root=/dev/ram0 rootfstype=ext2 init=/bin/busybox.nosuid -- sh
CVWSOC_LINUX_BOOTARGS_SDHCI ?= earlycon=uart8250,mmio,0x10000000 console=ttyS0,115200 ignore_loglevel loglevel=8 root=/dev/mmcblk0p5 rootfstype=ext2 rw rootwait init=/bin/busybox.nosuid -- sh
CVWSOC_LINUX_BOOTARGS ?= $(if $(CVWSOC_USE_EXT2),$(CVWSOC_LINUX_BOOTARGS_EXT2),$(CVWSOC_LINUX_BOOTARGS_BASE))
CVWSOC_LINUX_TINY_INIT ?= /bin/busybox.nosuid -- sh
CVWSOC_LINUX_DOOM_INIT ?= /sbin/init
CVWSOC_LINUX_FAST_INIT ?= $(if $(filter doom,$(CVWSOC_IMAGE_NAME)),$(CVWSOC_LINUX_DOOM_INIT),$(CVWSOC_LINUX_TINY_INIT))
CVWSOC_LINUX_FAST_MTD_BOOTARGS ?= earlycon=uart8250,mmio,0x10000000 console=ttyS0,115200 ignore_loglevel loglevel=8 root=/dev/mtdblock0 rootfstype=jffs2 rw init=$(CVWSOC_LINUX_FAST_INIT)
CVWSOC_LINUX_FAST_BOOTARGS ?= $(CVWSOC_LINUX_FAST_MTD_BOOTARGS)

RUNCMD ?= mount -t proc proc /proc

QEMU_BIN ?= qemu-system-riscv$(CVWSOC_XLEN)
QEMU_RAM_MB ?= 1024
CPU_ARGS_RV32 ?= rv32,pmp=on,debug=off
CPU_ARGS_RV64 ?= rva22s64,zicond=true,zfa=true,zfh=true,zcb=true,zbc=true,zkn=true,sstc=true,svadu=true,svnapot=true,pmp=on,debug=off
CPU_ARGS ?= $(if $(filter 32,$(CVWSOC_XLEN)),$(CPU_ARGS_RV32),$(CPU_ARGS_RV64))
GDB_BIN ?= riscv64-unknown-elf-gdb
OBJCOPY_BIN ?= objcopy
DTC_BIN ?= dtc
UNLZ4_BIN ?= unlz4

# Keep the address map aligned with Makefile.bridge for now.
OPENSBI_DTB_ADDR ?= 0x87000000
KERNEL_DTB_ADDR ?= 0x87000000
CVWSOC_KERNEL_ADDR ?= 0x80400000
KERNEL_ADDR ?= $(CVWSOC_KERNEL_ADDR)
UBOOT_DTB_ADDR ?= 0x80350000
UBOOT_ADDR ?= 0x80200000
INITRD_ADDR ?= 0x84200000
ROOTFS_ADDR ?= 0x8C000000
ROOTFS_COMPATIBLE ?= mtd-ram
ROOTFS_DTS_SIZE ?= 0x400000
ROOTFS_BANK_WIDTH ?= 1
ROOTFS_ERASE_SIZE ?= 0x2000
CVWSOC_QEMU_FAST_ROOTFS_ADDR ?= $(ROOTFS_ADDR)
CVWSOC_QEMU_FAST_ROOTFS_COMPATIBLE ?= $(ROOTFS_COMPATIBLE)
CVWSOC_QEMU_FAST_ROOTFS_BANK_WIDTH ?= $(ROOTFS_BANK_WIDTH)
CVWSOC_QEMU_FAST_ROOTFS_ERASE_SIZE ?= $(ROOTFS_ERASE_SIZE)
CVWSOC_QEMU_FAST_ROOTFS_MODE ?= jffs2
CVWSOC_QEMU_FAST_BOOTARGS ?= $(CVWSOC_LINUX_FAST_MTD_BOOTARGS)
CVWSOC_QEMU_FAST_ROOTFS_LOAD_ADDR ?= $(if $(filter jffs2,$(CVWSOC_QEMU_FAST_ROOTFS_MODE)),$(CVWSOC_QEMU_FAST_ROOTFS_ADDR),$(INITRD_ADDR))

# QEMU cannot boot the compressed kernel artifacts directly, so the "original"
# QEMU targets fall back to the generated decompressed helper when Image is not
# available in deploy/.
CVWSOC_QEMU_ORIG_KERNEL ?= $(if $(wildcard $(CVWSOC_DEPLOY_DIR)/Image),$(CVWSOC_DEPLOY_DIR)/Image,$(CVWSOC_LINUX_QEMU_KERNEL))
CVWSOC_QEMU_ORIG_INITRD ?= $(if $(CVWSOC_USE_EXT2),$(CVWSOC_LINUX_INITRD_EXT2),$(or $(CVWSOC_LINUX_INITRD_CPIO),$(CVWSOC_LINUX_QEMU_INITRD)))
CVWSOC_QEMU_UBOOT_KERNEL ?= $(if $(wildcard $(CVWSOC_DEPLOY_DIR)/Image),$(CVWSOC_DEPLOY_DIR)/Image,$(CVWSOC_UBOOT_QEMU_KERNEL))
CVWSOC_QEMU_UBOOT_INITRD ?= $(if $(CVWSOC_USE_EXT2),$(CVWSOC_LINUX_INITRD_EXT2),$(or $(CVWSOC_LINUX_INITRD_CPIO),$(CVWSOC_UBOOT_QEMU_INITRD)))
CVWSOC_QEMU_LINUX_DTB ?= $(CVWSOC_LINUX_QEMU_DTB)
CVWSOC_QEMU_UBOOT_DTB ?= $(CVWSOC_UBOOT_QEMU_DTB)
CVWSOC_QEMU_ORIG_UBOOT_DTB ?= $(CVWSOC_UBOOT_DTB)
CVWSOC_QEMU_LINUX_HELPERS := $(filter $(CVWSOC_PRELOAD_DIR)%,$(CVWSOC_QEMU_ORIG_KERNEL) $(CVWSOC_QEMU_ORIG_INITRD) $(CVWSOC_QEMU_LINUX_DTB))
CVWSOC_QEMU_UBOOT_HELPERS := $(filter $(CVWSOC_PRELOAD_DIR)%,$(CVWSOC_QEMU_UBOOT_KERNEL) $(CVWSOC_QEMU_UBOOT_INITRD) $(CVWSOC_QEMU_UBOOT_DTB) $(CVWSOC_QEMU_ORIG_UBOOT_DTB))

# --timing is needed
VLT_FLAGS ?= --assert --timing
# REMARK: using bigger value of THREADS seems to make simulation slower!
THREADS ?= 1
TRACE_DEPTH ?= 1
PARAMS ?= --trace-depth $(TRACE_DEPTH) --threads $(THREADS)
EXTRA_PARAMS ?=
NONPROF ?= --stats
#WARN_ARGS ?= -Wno-fatal -Werror-UNOPTFLAT
WARN_ARGS ?= -Wno-fatal
PLUS_ARGS ?=
EXTRA_PLUS_ARGS ?=
PARAM_ARGS ?=
DEFINE_ARGS ?=
BOOTROM_BIN ?=
EXT_RAM_BIN ?=
CVWSOC_BOOTROM_MEMH ?= $(WALLY)/fpga/src/boot.mem
CVWSOC_DATA_MEMH ?= $(WALLY)/fpga/src/data.mem
CVWSOC_BOOTROM_MEMH_DEPS := $(if $(CVWSOC_BOOTROM),$(CVWSOC_BOOTROM_MEMH) $(CVWSOC_DATA_MEMH))
CVWSOC_BOOTROM_PLUS_ARGS := $(if $(CVWSOC_BOOTROM),+BOOTROM_MEMH=$(CVWSOC_BOOTROM_MEMH) +UNCORE_RAM_MEMH=$(CVWSOC_DATA_MEMH))
UART_LOG ?=
# TRACE selects tracing mode: 0 disables, runtime/1 enables C++ SIGUSR1 FST, sv enables SV $dumpvars FST.
TRACE ?= 0
TRACE_ENABLED := $(filter-out 0 no NO false FALSE,$(TRACE))
TRACE_BUILD_ARGS := $(if $(TRACE_ENABLED),--trace-fst,)
TRACE_PARAM_ARG := $(if $(filter sv,$(TRACE)),MAKE_VCD=1,MAKE_VCD=0)
ALL_PARAM_ARGS := $(strip $(PARAM_ARGS) $(TRACE_PARAM_ARG))
EXPANDED_PARAM_ARGS := $(patsubst %,-G%,$(ALL_PARAM_ARGS))
UART_STDOUT ?= 0
UART_TIMESTAMP ?= 1
HEARTBEAT_SPEED_INTERVAL_CYCLES ?= 10000000
UART_PTY_TX ?= 1
UART_SHELL_TAGS ?= 0

CONFIG_VH ?= $(WALLY)/config/deriv/$(CONFIG)/config.vh
TESTBENCH ?= testbench_cvwsoc
TESTBENCH_MODULENAME ?= testbench_cvwsoc
BRIDGE_RTL_NEW := $(WALLY)/addins/ahb-axi-bridge/rtl/ahb_to_axi4_burst.sv
BRIDGE_RTL_OLD := $(WALLY)/addins/ahb-to-axi/rtl/ahb_to_axi4_burst.sv
BRIDGE_RTL ?= $(if $(wildcard $(BRIDGE_RTL_NEW)),$(BRIDGE_RTL_NEW),$(BRIDGE_RTL_OLD))
WRAPPER ?= $(WALLY)/sim/verilator/wrapper_cvwsoc.cpp
WORKDIR := $(VERILATOR_DIR)/wkdir/$(CONFIG)_cvwsoc$(if $(TRACE_ENABLED),_trace,)$(if $(CVWSOC_SIM_I2S),_i2s,)
RUNCMD_FILE ?= $(VERILATOR_DIR)/logs/testbench_cvwsoc_runcmd.txt

export CCACHE_DISABLE ?= 1

# Use the curated PULP sources from CopiedFiles_do_not_add_to_repo.  The copied
# tree already carries local naming adjustments such as `lzc_pulp`, which avoids
# colliding with Wally's own generic modules during Verilator elaboration.
COMMON_CELLS_SOURCES := \
	$(PULP_COMMON_CELLS_ROOT)/src/cf_math_pkg.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/binary_to_gray.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/gray_to_binary.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/sync.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/delta_counter.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/counter.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/lzc.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/id_queue.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/onehot_to_bin.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/fifo_v3.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/passthrough_stream_fifo.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/spill_register_flushable.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/spill_register.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/stream_register.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/fall_through_register.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/addr_decode_dync.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/addr_decode.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/cdc_fifo_gray.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/rr_arb_tree.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/stream_arbiter.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/stream_arbiter_flushable.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/stream_fifo.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/stream_fifo_optimal_wrap.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/stream_fork.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/stream_fork_dynamic.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/stream_join.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/stream_join_dynamic.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/stream_mux.sv \
	$(PULP_COMMON_CELLS_ROOT)/src/clk_int_div.sv \
