	$(IDMA_ROOT)/src/frontend/desc64/idma_desc64_axi_axis_ar_gen_prefetch.sv \
	$(IDMA_ROOT)/src/frontend/desc64/idma_desc64_axi_axis_reader.sv \
	$(IDMA_ROOT)/src/frontend/desc64/idma_desc64_axi_axis_reshaper.sv \
	$(IDMA_ROOT)/src/frontend/desc64/idma_desc64_axi_axis_top.sv \
	$(IDMA_ROOT)/src/frontend/idma_transfer_id_gen.sv \
