gen-cvwsoc-linux-preload: $(CVWSOC_LINUX_PRELOAD_BINS)

gen-cvwsoc-linux-fast-preload: $(CVWSOC_LINUX_FAST_PRELOAD_BINS)

gen-cvwsoc-uboot-preload: $(CVWSOC_UBOOT_PRELOAD_BINS)

############################################################################################
# qemu-{linux,u-boot}-preload: boot QEMU image with generated RAM contents (for validating generated RAM)
############################################################################################
# Remark: QEMU generates a DTB and passes parameters to OpenSBI accordingly if no -dtb is provided
QEMU_TMP_LINUX_BOOTROM := $(CVWSOC_PRELOAD_DIR)/bootmem-cvwsoc-linux-qemu.bin
QEMU_TMP_LINUX_RAM := $(CVWSOC_PRELOAD_DIR)/ram-cvwsoc-linux-qemu.bin
QEMU_TMP_LINUX_FAST_BOOTROM := $(CVWSOC_PRELOAD_DIR)/bootmem-cvwsoc-linux-fast-qemu.bin
QEMU_TMP_LINUX_FAST_RAM := $(CVWSOC_PRELOAD_DIR)/ram-cvwsoc-linux-fast-qemu.bin
qemu-linux-preload: $(CVWSOC_LINUX_BOOTROM_BIN) $(CVWSOC_LINUX_EXT_RAM_BIN)
	$(OBJCOPY_BIN) -I binary -O binary --reverse-bytes=$(CVWSOC_WORD_BYTES) \
		$(CVWSOC_LINUX_BOOTROM_BIN) $(QEMU_TMP_LINUX_BOOTROM)
	$(OBJCOPY_BIN) -I binary -O binary --reverse-bytes=$(CVWSOC_WORD_BYTES) \
		$(CVWSOC_LINUX_EXT_RAM_BIN) $(QEMU_TMP_LINUX_RAM)
	$(QEMU_BIN) \
		-M virt -m $(QEMU_RAM_MB)M -nographic \
		-bios none \
		-cpu "$(CPU_ARGS)" \
		-device loader,file=$(QEMU_TMP_LINUX_BOOTROM),addr=0x1000,force-raw=on \
		-device loader,file=$(QEMU_TMP_LINUX_RAM),addr=0x80000000,force-raw=on
	rm -f $(QEMU_TMP_LINUX_BOOTROM) $(QEMU_TMP_LINUX_RAM)

qemu-linux-fast-preload: $(CVWSOC_LINUX_FAST_BOOTROM_BIN) $(CVWSOC_LINUX_FAST_EXT_RAM_BIN) $(CVWSOC_LINUX_FAST_QEMU_ROOTFS)
	$(OBJCOPY_BIN) -I binary -O binary --reverse-bytes=$(CVWSOC_WORD_BYTES) \
		$(CVWSOC_LINUX_FAST_BOOTROM_BIN) $(QEMU_TMP_LINUX_FAST_BOOTROM)
	$(OBJCOPY_BIN) -I binary -O binary --reverse-bytes=$(CVWSOC_WORD_BYTES) \
		$(CVWSOC_LINUX_FAST_EXT_RAM_BIN) $(QEMU_TMP_LINUX_FAST_RAM)
	$(QEMU_BIN) \
		-M virt -m $(QEMU_RAM_MB)M -nographic \
		-bios none \
		-cpu "$(CPU_ARGS)" \
		-device loader,file=$(QEMU_TMP_LINUX_FAST_BOOTROM),addr=0x1000,force-raw=on \
		-device loader,file=$(QEMU_TMP_LINUX_FAST_RAM),addr=0x80000000,force-raw=on
	rm -f $(QEMU_TMP_LINUX_FAST_BOOTROM) $(QEMU_TMP_LINUX_FAST_RAM)

qemu-preload-linux-fast: qemu-linux-fast-preload


QEMU_TMP_UBOOT_BOOTROM := $(CVWSOC_PRELOAD_DIR)/bootmem-cvwsoc-uboot-qemu.bin
QEMU_TMP_UBOOT_RAM := $(CVWSOC_PRELOAD_DIR)/ram-cvwsoc-uboot-qemu.bin
qemu-uboot-preload: $(CVWSOC_UBOOT_BOOTROM_BIN) $(CVWSOC_UBOOT_EXT_RAM_BIN)
	$(OBJCOPY_BIN) -I binary -O binary --reverse-bytes=$(CVWSOC_WORD_BYTES) \
		$(CVWSOC_UBOOT_BOOTROM_BIN) $(QEMU_TMP_UBOOT_BOOTROM)
	$(OBJCOPY_BIN) -I binary -O binary --reverse-bytes=$(CVWSOC_WORD_BYTES) \
		$(CVWSOC_UBOOT_EXT_RAM_BIN) $(QEMU_TMP_UBOOT_RAM)
	$(QEMU_BIN) \
		-M virt -m $(QEMU_RAM_MB)M -nographic \
		-bios none \
		-cpu "$(CPU_ARGS)" \
		-device loader,file=$(QEMU_TMP_UBOOT_BOOTROM),addr=0x1000,force-raw=on \
		-device loader,file=$(QEMU_TMP_UBOOT_RAM),addr=0x80000000,force-raw=on
	rm -f $(QEMU_TMP_UBOOT_BOOTROM) $(QEMU_TMP_UBOOT_RAM)


qemu-linux: $(CVWSOC_LINUX_QEMU_ASSETS) $(CVWSOC_UBOOT_STUB_BIN)
	$(QEMU_BIN) \
		-M virt -m $(QEMU_RAM_MB)M -nographic \
		-bios $(CVWSOC_FW_JUMP_BIN) \
		-dtb $(CVWSOC_QEMU_LINUX_DTB) \
		-device loader,file=$(CVWSOC_UBOOT_STUB_BIN),addr=$(UBOOT_ADDR),force-raw=on \
		-device loader,file=$(CVWSOC_LINUX_QEMU_KERNEL),addr=$(CVWSOC_KERNEL_ADDR) \
		-device loader,file=$(CVWSOC_QEMU_LINUX_DTB),addr=$(KERNEL_DTB_ADDR) \
		-device loader,file=$(CVWSOC_LINUX_QEMU_INITRD),addr=$(INITRD_ADDR) \
		-cpu "$(CPU_ARGS)"

qemu-linux-fast: $(CVWSOC_LINUX_FAST_QEMU_ASSETS) $(CVWSOC_UBOOT_STUB_BIN)
	$(QEMU_BIN) \
		-M virt -m $(QEMU_RAM_MB)M -nographic \
		-bios $(CVWSOC_FW_JUMP_BIN) \
		-dtb $(CVWSOC_LINUX_FAST_QEMU_DTB) \
		-device loader,file=$(CVWSOC_UBOOT_STUB_BIN),addr=$(UBOOT_ADDR),force-raw=on \
		-device loader,file=$(CVWSOC_LINUX_FAST_QEMU_KERNEL),addr=$(CVWSOC_KERNEL_ADDR) \
		-device loader,file=$(CVWSOC_LINUX_FAST_QEMU_DTB),addr=$(KERNEL_DTB_ADDR) \
		-device loader,file=$(CVWSOC_LINUX_FAST_QEMU_ROOTFS),addr=$(CVWSOC_QEMU_FAST_ROOTFS_LOAD_ADDR),force-raw=on \
		-cpu "$(CPU_ARGS)"

qemu-uboot: $(CVWSOC_QEMU_UBOOT_HELPERS)
	$(QEMU_BIN) \
		-M virt -m $(QEMU_RAM_MB)M -nographic \
		-bios $(CVWSOC_FW_JUMP_BIN) \
		-dtb $(CVWSOC_QEMU_UBOOT_DTB) \
		-device loader,file=$(CVWSOC_UBOOT_BIN),addr=$(UBOOT_ADDR),force-raw=on \
		-device loader,file=$(CVWSOC_QEMU_ORIG_UBOOT_DTB),addr=$(UBOOT_DTB_ADDR) \
		-device loader,file=$(CVWSOC_QEMU_UBOOT_KERNEL),addr=$(CVWSOC_KERNEL_ADDR) \
		-device loader,file=$(CVWSOC_QEMU_UBOOT_DTB),addr=$(KERNEL_DTB_ADDR) \
		-device loader,file=$(CVWSOC_QEMU_UBOOT_INITRD),addr=$(INITRD_ADDR) \
		-cpu "$(CPU_ARGS)"

CVWSOC_LINUX_RUN_DEPS := $(or $(CVWSOC_BOOTROM_MEMH_DEPS),$(CVWSOC_LINUX_RUN_PRELOAD_BINS))
CVWSOC_LINUX_FAST_RUN_DEPS := $(or $(CVWSOC_BOOTROM_MEMH_DEPS),$(CVWSOC_LINUX_FAST_PRELOAD_BINS))
CVWSOC_UBOOT_RUN_DEPS := $(or $(CVWSOC_BOOTROM_MEMH_DEPS),$(CVWSOC_UBOOT_RUN_PRELOAD_BINS))
CVWSOC_LINUX_RUNCMD_DEPS := $(or $(CVWSOC_BOOTROM_MEMH_DEPS),$(CVWSOC_LINUX_PRELOAD_BINS))
CVWSOC_UBOOT_RUNCMD_DEPS := $(or $(CVWSOC_BOOTROM_MEMH_DEPS),$(CVWSOC_UBOOT_PRELOAD_BINS))

run-cvwsoc-linux: BOOTROM_BIN := $(if $(CVWSOC_BOOTROM),,$(CVWSOC_LINUX_BOOTROM_BIN))
run-cvwsoc-linux: EXT_RAM_BIN := $(if $(CVWSOC_BOOTROM),,$(CVWSOC_LINUX_RUN_EXT_RAM_BIN))
run-cvwsoc-linux: UART_LOG := $(VERILATOR_DIR)/logs/testbench_cvwsoc_linux_uart.out
run-cvwsoc-linux: $(CVWSOC_LINUX_RUN_DEPS) $(WORKDIR)/V$(TESTBENCH) $(CVWSOC_SD_IMAGE_DEPS)
	$(RUN_VERILATOR)

run-cvwsoc-linux-fast: BOOTROM_BIN := $(if $(CVWSOC_BOOTROM),,$(CVWSOC_LINUX_FAST_BOOTROM_BIN))
run-cvwsoc-linux-fast: EXT_RAM_BIN := $(if $(CVWSOC_BOOTROM),,$(CVWSOC_LINUX_FAST_EXT_RAM_BIN))
run-cvwsoc-linux-fast: UART_LOG := $(VERILATOR_DIR)/logs/testbench_cvwsoc_linux_fast_uart.out
run-cvwsoc-linux-fast: $(CVWSOC_LINUX_FAST_RUN_DEPS) $(WORKDIR)/V$(TESTBENCH) $(CVWSOC_SD_IMAGE_DEPS)
	$(RUN_VERILATOR)

# Fastest road to Linux shell prompt
sim-fast:
	$(MAKE) -f $(lastword $(MAKEFILE_LIST)) RV32=$(RV32) CONFIG=$(CONFIG) CPUSETTINGS="$(CPUSETTINGS)" run-cvwsoc-linux-fast -j$$(nproc)

# Fastest road to U-Boot prompt
sim-fast-uboot:
	$(MAKE) -f $(lastword $(MAKEFILE_LIST)) RV32=$(RV32) CONFIG=$(CONFIG) CPUSETTINGS="$(CPUSETTINGS)" run-cvwsoc-uboot -j$$(nproc)

run-cvwsoc-uboot: BOOTROM_BIN := $(if $(CVWSOC_BOOTROM),,$(CVWSOC_UBOOT_BOOTROM_BIN))
run-cvwsoc-uboot: EXT_RAM_BIN := $(if $(CVWSOC_BOOTROM),,$(CVWSOC_UBOOT_RUN_EXT_RAM_BIN))
run-cvwsoc-uboot: UART_LOG := $(VERILATOR_DIR)/logs/testbench_cvwsoc_uboot_uart.out
run-cvwsoc-uboot: $(CVWSOC_UBOOT_RUN_DEPS) $(WORKDIR)/V$(TESTBENCH) $(CVWSOC_SD_IMAGE_DEPS)
	$(RUN_VERILATOR)

# FIXME: this serial autorun path was copied forward conceptually from the old
# bridge bench but has not been revalidated end-to-end on the new cvwsoc setup.
runcmd-cvwsoc-linux: BOOTROM_BIN := $(if $(CVWSOC_BOOTROM),,$(CVWSOC_LINUX_BOOTROM_BIN))
runcmd-cvwsoc-linux: EXT_RAM_BIN := $(if $(CVWSOC_BOOTROM),,$(CVWSOC_LINUX_EXT_RAM_BIN))
runcmd-cvwsoc-linux: UART_LOG := $(VERILATOR_DIR)/logs/testbench_cvwsoc_linux_uart.out
runcmd-cvwsoc-linux: EXTRA_PLUS_ARGS += +UART_AUTORUNCMD=1 +UART_RUNCMD_FILE=$(RUNCMD_FILE)
runcmd-cvwsoc-linux: $(CVWSOC_LINUX_RUNCMD_DEPS) $(WORKDIR)/V$(TESTBENCH) $(CVWSOC_SD_IMAGE_DEPS)
	test -n "$(RUNCMD)"
	mkdir -p $(VERILATOR_DIR)/logs
	printf '%s\r' "$(RUNCMD)" > $(RUNCMD_FILE)
	$(RUN_VERILATOR)

runcmd-cvwsoc-uboot: BOOTROM_BIN := $(if $(CVWSOC_BOOTROM),,$(CVWSOC_UBOOT_BOOTROM_BIN))
runcmd-cvwsoc-uboot: EXT_RAM_BIN := $(if $(CVWSOC_BOOTROM),,$(CVWSOC_UBOOT_EXT_RAM_BIN))
runcmd-cvwsoc-uboot: UART_LOG := $(VERILATOR_DIR)/logs/testbench_cvwsoc_uboot_uart.out
runcmd-cvwsoc-uboot: EXTRA_PLUS_ARGS += +UART_AUTORUNCMD=1 +UART_RUNCMD_FILE=$(RUNCMD_FILE)
runcmd-cvwsoc-uboot: $(CVWSOC_UBOOT_RUNCMD_DEPS) $(WORKDIR)/V$(TESTBENCH) $(CVWSOC_SD_IMAGE_DEPS)
	test -n "$(RUNCMD)"
	mkdir -p $(VERILATOR_DIR)/logs
	printf '%s\r' "$(RUNCMD)" > $(RUNCMD_FILE)
	$(RUN_VERILATOR)

$(WORKDIR)/V$(TESTBENCH): $(WORKDIR)/V$(TESTBENCH).mk $(WRAPPER)
	$(MAKE) -C $(WORKDIR) -f V$(TESTBENCH).mk \
		OBJCACHE=ccache $(OPT_GEN) USER_CPPFLAGS="$(USER_CPPFLAGS) $(VERILATOR_USER_CPPFLAGS)" CXX=/usr/bin/g++ LINK=/usr/bin/g++ V$(TESTBENCH)

$(WORKDIR)/V$(TESTBENCH).mk: $(DEPENDENCIES)
	mkdir -p $(WORKDIR)
	@echo "Using Verilator: $(VERILATOR)"
	@$(VERILATOR) --version
	$(VERILATOR) \
	--Mdir $(WORKDIR) -o V$(TESTBENCH) \
	--cc --exe $(TRACE_BUILD_ARGS) \
	$(VLT_FLAGS) $(OPT_COMP) $(PARAMS) $(EXTRA_PARAMS) $(NONPROF) $(WARN_ARGS) \
	--top-module $(TESTBENCH_MODULENAME) --relative-includes \
	$(INCLUDE_PATH) \
	$(WRAPPER) \
	$(DEFINE_ARGS) \
	$(if $(filter $(BOOL_TRUE),$(CVWSOC_SIM_AXI_RAM)),-DSIM_AXI_RAM,) \
	$(if $(CVWSOC_SIM_SDHCI),-DSIM_AXI_SDHCI,) \
	$(if $(CVWSOC_SIM_DMA),-DSIM_AXI_DMA,) \
	$(if $(CVWSOC_SIM_I2S),-DSIM_I2S,) \
	$(EXPANDED_PARAM_ARGS) \
	$(SOURCES)

cleantb:
	rm -rf \
		$(VERILATOR_DIR)/wkdir/$(CONFIG)_cvwsoc \
		$(VERILATOR_DIR)/wkdir/$(CONFIG)_cvwsoc_trace \
		$(VERILATOR_DIR)/wkdir/$(CONFIG)_cvwsoc_i2s \
		$(VERILATOR_DIR)/wkdir/$(CONFIG)_cvwsoc_trace_i2s \
		$(VERILATOR_DIR)/logs/testbench_cvwsoc*.out \
		$(VERILATOR_DIR)/logs/testbench_cvwsoc*.pid \
		$(RUNCMD_FILE) \
		dump.fst

clean: cleantb
	rm -rf \
		$(CVWSOC_LINUX_QEMU_CFG) \
		$(CVWSOC_UBOOT_QEMU_CFG) \
		$(CVWSOC_LINUX_FAST_QEMU_CFG) \
		$(CVWSOC_LINUX_PRELOAD_CFG) \
		$(CVWSOC_UBOOT_PRELOAD_CFG) \
		$(CVWSOC_LINUX_FAST_PRELOAD_CFG) \
		$(CVWSOC_VERILATOR_SDHCI_DTS) \
		$(CVWSOC_VERILATOR_SDHCI_DTB) \
		$(CVWSOC_LINUX_QEMU_ASSETS) \
		$(CVWSOC_UBOOT_QEMU_ASSETS) \
		$(CVWSOC_LINUX_FAST_QEMU_ASSETS) \
		$(CVWSOC_LINUX_PRELOAD_BINS) \
		$(CVWSOC_UBOOT_PRELOAD_BINS) \
		$(CVWSOC_LINUX_FAST_PRELOAD_BINS) \
		$(CVWSOC_LINUX_RAW_BOOTROM_BIN) \
		$(CVWSOC_LINUX_RAW_EXT_RAM_BIN) \
		$(CVWSOC_UBOOT_RAW_BOOTROM_BIN) \
		$(CVWSOC_UBOOT_RAW_EXT_RAM_BIN) \
		$(CVWSOC_LINUX_FAST_RAW_BOOTROM_BIN) \
		$(CVWSOC_LINUX_FAST_RAW_EXT_RAM_BIN) \
		$(CVWSOC_SD_IMAGE) \
		$(CVWSOC_SD_IMAGE).tmp
