I2S_SOURCES := $(if $(CVWSOC_SIM_I2S), \
	$(WALLY)/addins/verilog-axis/rtl/axis_adapter.v \
	$(WALLY)/addins/verilog-axis/rtl/axis_async_fifo.v \
	$(WALLY)/addins/verilog-axis/rtl/axis_async_fifo_adapter.v \
	$(WALLY)/addins/digilent-i2s2/shared/src/hdl/axis_i2s2.v,)


CORE_SOURCES := $(filter-out \
	$(wildcard $(COPIED_ROOT)/testbench/sdc/*.sv) \
	$(wildcard $(COPIED_ROOT)/ahb-to-axi/*/*.sv) \
	$(wildcard $(COPIED_ROOT)/cvwsoc/*.sv) \
	$(wildcard $(COPIED_ROOT)/cvwsoc/*/*.sv) \
	$(wildcard $(COPIED_ROOT)/rvvi/*.sv) \
	$(wildcard $(COPIED_ROOT)/uberddr3/*/*.sv) \
	$(wildcard $(COPIED_ROOT)/sdhci/hw/*.sv) \
	$(wildcard $(COPIED_ROOT)/sdhci/hw/*/*.sv), \
	$(wildcard $(COPIED_ROOT)/*/*.sv) \
	$(wildcard $(COPIED_ROOT)/*/*/*.sv))

#	$(wildcard $(COPIED_ROOT)/testbench/sdc/*.sv)

SDHCI_PERIPH_SOURCES := \
	$(wildcard $(COPIED_ROOT)/pulp/tech_cells/src/rtl/*.sv) \
    $(wildcard $(COPIED_ROOT)/sdhci/target/sim/model/*.sv) \
	$(wildcard $(COPIED_ROOT)/cvwsoc/axi64_mmio_to_axilite32_v2.sv) \
	$(wildcard $(COPIED_ROOT)/cvwsoc/axi_mmio_to_axilite32_v3.sv) \
	$(wildcard $(COPIED_ROOT)/sdhci/hw/reg/sdhci_reg_pkg.sv) \
	$(wildcard $(COPIED_ROOT)/sdhci/hw/sdhci_pkg.sv) \
	$(wildcard $(COPIED_ROOT)/sdhci/hw/autocmd_wrap.sv) \
	$(wildcard $(COPIED_ROOT)/sdhci/hw/dat_wrap.sv) \
	$(wildcard $(COPIED_ROOT)/sdhci/hw/dat_buffer.sv) \
	$(wildcard $(COPIED_ROOT)/sdhci/hw/sram_shift_reg.sv) \
	$(wildcard $(COPIED_ROOT)/sdhci/hw/dat_timeout.sv) \
	$(wildcard $(COPIED_ROOT)/sdhci/hw/cmd_logic.sv) \
	$(wildcard $(COPIED_ROOT)/sdhci/hw/par_ser_shift_reg.sv) \
	$(wildcard $(COPIED_ROOT)/sdhci/hw/sd_clk_generator.sv) \
	$(wildcard $(COPIED_ROOT)/sdhci/hw/sdhci_debounce.sv) \
	$(wildcard $(COPIED_ROOT)/sdhci/hw/*/*.sv) \
	$(wildcard $(COPIED_ROOT)/sdhci/hw/sdhci_top.sv) \
	$(wildcard $(COPIED_ROOT)/cvwsoc/sdhci/sdhci_regbus_pkg.sv) \
    $(wildcard $(COPIED_ROOT)/cvwsoc/sdhci/model/*.v) \
	$(wildcard $(COPIED_ROOT)/cvwsoc/sdhci/sd*.v) \
	$(wildcard $(COPIED_ROOT)/cvwsoc/sdhci/*.sv)


# FIXME: separate this into groups?
PERIPH_SOURCES := \
	$(if $(CVWSOC_SIM_SDHCI),$(SDHCI_PERIPH_SOURCES),)

# CVW already has an sdModel probably also coming from OpenCores (using that one for now)
#	$(wildcard $(COPIED_ROOT)/cvwsoc/sdhci/sdModel.v)


INCLUDE_PATH := \
	-I$(COPIED_ROOT)/config \
	-I$(WALLY)/config/shared \
	-I$(PULP_AXI_ROOT)/include \
	-I$(PULP_AXI_STREAM_ROOT)/include \
	-I$(PULP_COMMON_CELLS_ROOT)/include \
	-I$(PULP_REGISTER_INTERFACE_ROOT)/include \
	-I$(IDMA_ROOT)/src/include \
	-I$(SDHCI_ROOT)/include

VERILOG_AXI_SOURCES := \
	$(wildcard $(COPIED_ROOT)/verilog-axi/rtl/axi_ram.v)

SOURCES := \
	$(COMMON_CELLS_SOURCES) \
	$(AXI_SOURCES) \
	$(COPIED_ROOT)/cvw.sv \
	$(WALLY)/testbench/$(TESTBENCH).sv \
	$(CORE_SOURCES) \
	$(BRIDGE_RTL) \
	$(VERILOG_AXI_SOURCES) \
	$(PULP_REGISTER_INTERFACE_SOURCES) \
	$(IDMA_SOURCES) \
	$(I2S_SOURCES) \
	$(PERIPH_SOURCES)

DEPENDENCIES := \
	$(lastword $(MAKEFILE_LIST)) \
	$(WALLY)/config/shared/*.vh \
	$(COPIED_ROOT)/config/config.vh \
	$(SOURCES)

$(COPIED_ROOT)/config/config.vh: $(CONFIG_VH) FORCE
	mkdir -p $(dir $@)
	@if ! cmp -s "$<" "$@"; then cp "$<" "$@"; fi

$(IDMA_GENERATED_SOURCES):
	$(MAKE) -C $(IDMA_ROOT) \
		IDMA_REG_DIR=$(PULP_REGISTER_INTERFACE_ROOT) \
		IDMA_CC_DIR=$(PULP_COMMON_CELLS_ROOT) \
		$(patsubst $(IDMA_ROOT)/%,%,$@)

# this is for GCC
OPT_GEN ?= VM_PARALLEL_BUILDS=1 OPT_FAST="-O3 -march=native" OPT_GLOBAL="-O3 -march=native" OPT_SLOW="-O1"
OPT_COMP ?= -O3
VERILATOR_USER_CPPFLAGS ?= -DsetBit=set

define RUN_VERILATOR
	mkdir -p $(VERILATOR_DIR)/logs
	args='$(PLUS_ARGS) $(EXTRA_PLUS_ARGS) $(CVWSOC_BOOTROM_PLUS_ARGS) +VERILATOR_THREADS=$(THREADS) +UART_STDOUT=$(UART_STDOUT) +UART_TIMESTAMP=$(UART_TIMESTAMP) +UART_SHELL_TAGS=$(UART_SHELL_TAGS) +HEARTBEAT_SPEED_INTERVAL_CYCLES=$(HEARTBEAT_SPEED_INTERVAL_CYCLES) +UART_PTY_TX=$(UART_PTY_TX)'; \
	if [[ -n "$(BOOTROM_BIN)" ]]; then args="$$args +BOOTROM_BIN=$(BOOTROM_BIN)"; fi; \
	if [[ -n "$(EXT_RAM_BIN)" ]]; then args="$$args +EXT_RAM_BIN=$(EXT_RAM_BIN)"; fi; \
	if [[ -n "$(CVWSOC_SD_IMAGE_DEPS)" ]]; then args="$$args +SD_IMAGE=$(CVWSOC_SD_IMAGE)"; fi; \
	if [[ -n "$(UART_LOG)" ]]; then args="$$args +UART_LOG=$(UART_LOG)"; fi; \
	$(CPUSETTINGS) $(WORKDIR)/V$(TESTBENCH) $$args
endef

define CVWSOC_PRELOAD_COMMON_ENV
CVWSOC_DEPLOY_DIR=$(CVWSOC_DEPLOY_DIR) \
CVWSOC_PRELOAD_DIR=$(CVWSOC_PRELOAD_DIR) \
IMAGE_KIND=$(CVWSOC_IMAGE_NAME) \
INITRD_EXT2=$(if $(CVWSOC_USE_EXT2),1,0) \
FW_JUMP_BIN=$(CVWSOC_FW_JUMP_BIN) \
KERNEL_SRC=$(CVWSOC_LINUX_KERNEL_SRC) \
INITRD_SRC=$(CVWSOC_LINUX_INITRD_SRC) \
DTS_SRC=$(CVWSOC_DTS_SRC) \
BOOTARGS='$(CVWSOC_LINUX_BOOTARGS)' \
QEMU_BIN=$(QEMU_BIN) \
QEMU_RAM_MB=$(QEMU_RAM_MB) \
CPU_ARGS='$(CPU_ARGS)' \
GDB_BIN=$(GDB_BIN) \
OBJCOPY_BIN=$(OBJCOPY_BIN) \
DTC_BIN=$(DTC_BIN) \
UNLZ4_BIN=$(UNLZ4_BIN) \
CVWSOC_XLEN=$(CVWSOC_XLEN) \
CVWSOC_BUS_WIDTH=$(CVWSOC_BUS_WIDTH) \
PRELOAD_WORD_BYTES=$(CVWSOC_WORD_BYTES) \
OPENSBI_DTB_ADDR=$(OPENSBI_DTB_ADDR) \
KERNEL_DTB_ADDR=$(KERNEL_DTB_ADDR) \
UBOOT_DTB_ADDR=$(UBOOT_DTB_ADDR) \
UBOOT_ADDR=$(UBOOT_ADDR) \
UBOOT_STUB_BIN=$(CVWSOC_UBOOT_STUB_BIN) \
INITRD_ADDR=$(INITRD_ADDR)
endef

all: run-cvwsoc-linux
linux: run-cvwsoc-linux
uboot: run-cvwsoc-uboot
run-cvwsoc: run-cvwsoc-linux
qemu: qemu-linux
qemu-preload: qemu-linux-preload
runcmd-cvwsoc: runcmd-cvwsoc-linux

$(CVWSOC_PRELOAD_DIR):
	mkdir -p $@

$(CVWSOC_UBOOT_STUB_ELF): $(VERILATOR_DIR)/uboot_replacement_stub.S | $(CVWSOC_PRELOAD_DIR)
	$(RISCV_GCC_BIN) \
		-march=$(CVWSOC_STUB_MARCH) \
		-mabi=$(CVWSOC_STUB_MABI) \
		-nostdlib -nostartfiles -static \
		-Wl,-Ttext=$(UBOOT_ADDR) \
		-Wl,--build-id=none \
		-o $@ \
		$<

$(CVWSOC_UBOOT_STUB_BIN): $(CVWSOC_UBOOT_STUB_ELF)
	$(RISCV_OBJCOPY_BIN) -O binary $< $@

$(CVWSOC_VERILATOR_SDHCI_DTS): $(CVWSOC_DTS_SRC) FORCE | $(CVWSOC_PRELOAD_DIR)
	@tmp="$@.tmp"; \
	sed \
		-e '/^[[:space:]]*linux,initrd-start[[:space:]]*=/d' \
		-e '/^[[:space:]]*linux,initrd-end[[:space:]]*=/d' \
		-e 's|^[[:space:]]*bootargs[[:space:]]*=.*|    bootargs = "$(CVWSOC_LINUX_BOOTARGS_SDHCI)";|' \
		-e '/mmc@10090000[[:space:]]*{/,/^[[:space:]]*};/ s/status[[:space:]]*=[[:space:]]*"disabled"/status = "okay"/' \
		"$<" > "$$tmp"; \
	if ! cmp -s "$$tmp" "$@"; then mv "$$tmp" "$@"; else rm -f "$$tmp"; fi

$(CVWSOC_VERILATOR_SDHCI_DTB): $(CVWSOC_VERILATOR_SDHCI_DTS)
	$(DTC_BIN) -I dts -O dtb $< -o $@

$(CVWSOC_SD_IMAGE): $(CVWSOC_SD_IMAGE_SRC) FORCE
	test -n "$(CVWSOC_SD_IMAGE_SRC)"
	mkdir -p $(dir $@)
	if gzip -t $< >/dev/null 2>&1; then \
		gzip -dc $< > $@.tmp; \
	else \
		cp $< $@.tmp; \
	fi
	mv $@.tmp $@

gen-cvwsoc-sd-image: $(CVWSOC_SD_IMAGE_DEPS)

define PATCH_CVWSOC_RUN_DTB
	test -n "$(CVWSOC_VERILATOR_DTB)"
	test -f "$(CVWSOC_VERILATOR_DTB)"
	mkdir -p $(CVWSOC_PRELOAD_DIR)
	cp $< $@
	tmp="$@.dtb.rev.tmp"; \
	cp "$(CVWSOC_VERILATOR_DTB)" "$$tmp.in"; \
	truncate -s %$(CVWSOC_WORD_BYTES) "$$tmp.in"; \
	$(OBJCOPY_BIN) --reverse-bytes=$(CVWSOC_WORD_BYTES) -F binary "$$tmp.in" "$$tmp"; \
	offset=$$(( $(KERNEL_DTB_ADDR) - 0x80000000 )); \
	dd if="$$tmp" of="$@" bs=1 seek="$$offset" conv=notrunc status=none; \
	rm -f "$$tmp" "$$tmp.in"
endef

$(CVWSOC_PRELOAD_DIR)/ram-cvwsoc-linux-run.bin: $(CVWSOC_LINUX_EXT_RAM_BIN) $(CVWSOC_VERILATOR_DTB) FORCE | $(CVWSOC_PRELOAD_DIR)
	$(PATCH_CVWSOC_RUN_DTB)

$(CVWSOC_PRELOAD_DIR)/ram-cvwsoc-uboot-run.bin: $(CVWSOC_UBOOT_EXT_RAM_BIN) $(CVWSOC_VERILATOR_DTB) FORCE | $(CVWSOC_PRELOAD_DIR)
	$(PATCH_CVWSOC_RUN_DTB)

FORCE:

CVWSOC_CFG_QEMU_KEYS := \
	MODE IMAGE_KIND INITRD_EXT2 FW_JUMP_BIN KERNEL_SRC INITRD_SRC DTS_SRC BOOTARGS \
	QEMU_RAM_MB CPU_ARGS CVWSOC_XLEN CVWSOC_BUS_WIDTH PRELOAD_WORD_BYTES \
	DTC_BIN UNLZ4_BIN KERNEL_ADDR UBOOT_ADDR UBOOT_STUB_BIN KERNEL_DTB_ADDR INITRD_ADDR \
	QEMU_KERNEL QEMU_INITRD GENERATED_DTS GENERATED_DTB EXTERNAL_DTB

CVWSOC_CFG_FAST_KEYS := \
	MODE ROOTFS_MODE IMAGE_KIND FW_JUMP_BIN KERNEL_SRC INITRD_SRC DTS_SRC BOOTARGS \
	QEMU_RAM_MB CPU_ARGS CVWSOC_XLEN CVWSOC_BUS_WIDTH PRELOAD_WORD_BYTES \
	DTC_BIN UNLZ4_BIN KERNEL_ADDR UBOOT_ADDR UBOOT_STUB_BIN KERNEL_DTB_ADDR INITRD_ADDR \
	ROOTFS_ADDR ROOTFS_COMPATIBLE ROOTFS_DTS_SIZE ROOTFS_BANK_WIDTH ROOTFS_ERASE_SIZE \
	QEMU_KERNEL QEMU_INITRD GENERATED_DTS GENERATED_DTB EXTERNAL_DTB

CVWSOC_CFG_UBOOT_QEMU_KEYS := \
	MODE IMAGE_KIND INITRD_EXT2 FW_JUMP_BIN UBOOT_BIN UBOOT_DTB KERNEL_SRC INITRD_SRC DTS_SRC BOOTARGS \
	QEMU_RAM_MB CPU_ARGS CVWSOC_XLEN CVWSOC_BUS_WIDTH PRELOAD_WORD_BYTES \
	DTC_BIN UNLZ4_BIN KERNEL_ADDR UBOOT_DTB_ADDR KERNEL_DTB_ADDR INITRD_ADDR \
	QEMU_KERNEL QEMU_INITRD GENERATED_DTS GENERATED_DTB

CVWSOC_CFG_PRELOAD_KEYS := \
	MODE IMAGE_KIND INITRD_EXT2 FW_JUMP_BIN KERNEL_SRC INITRD_SRC DTS_SRC BOOTARGS \
	QEMU_BIN QEMU_RAM_MB CPU_ARGS GDB_BIN OBJCOPY_BIN CVWSOC_XLEN CVWSOC_BUS_WIDTH PRELOAD_WORD_BYTES \
	DTC_BIN UNLZ4_BIN KERNEL_ADDR UBOOT_ADDR UBOOT_STUB_BIN KERNEL_DTB_ADDR INITRD_ADDR \
	RAW_BOOTMEM_FILE BOOTMEM_FILE RAW_RAM_FILE RAM_FILE QEMU_KERNEL QEMU_INITRD GENERATED_DTS GENERATED_DTB

CVWSOC_CFG_FAST_PRELOAD_KEYS := \
	MODE ROOTFS_MODE IMAGE_KIND FW_JUMP_BIN KERNEL_SRC INITRD_SRC DTS_SRC BOOTARGS \
	QEMU_BIN QEMU_RAM_MB CPU_ARGS GDB_BIN OBJCOPY_BIN CVWSOC_XLEN CVWSOC_BUS_WIDTH PRELOAD_WORD_BYTES \
	DTC_BIN UNLZ4_BIN KERNEL_ADDR UBOOT_ADDR UBOOT_STUB_BIN KERNEL_DTB_ADDR INITRD_ADDR \
	ROOTFS_ADDR ROOTFS_COMPATIBLE ROOTFS_DTS_SIZE ROOTFS_BANK_WIDTH ROOTFS_ERASE_SIZE \
	RAW_BOOTMEM_FILE BOOTMEM_FILE RAW_RAM_FILE RAM_FILE QEMU_KERNEL QEMU_INITRD GENERATED_DTS GENERATED_DTB

CVWSOC_CFG_UBOOT_PRELOAD_KEYS := \
	MODE IMAGE_KIND INITRD_EXT2 FW_JUMP_BIN UBOOT_BIN UBOOT_DTB KERNEL_SRC INITRD_SRC DTS_SRC BOOTARGS \
	QEMU_BIN QEMU_RAM_MB CPU_ARGS GDB_BIN OBJCOPY_BIN CVWSOC_XLEN CVWSOC_BUS_WIDTH PRELOAD_WORD_BYTES \
	DTC_BIN UNLZ4_BIN KERNEL_ADDR UBOOT_DTB_ADDR KERNEL_DTB_ADDR INITRD_ADDR \
	RAW_BOOTMEM_FILE BOOTMEM_FILE RAW_RAM_FILE RAM_FILE QEMU_KERNEL QEMU_INITRD GENERATED_DTS GENERATED_DTB EXTERNAL_DTB

CVWSOC_CFG_IMAGE_KIND = $(CVWSOC_IMAGE_NAME)
CVWSOC_CFG_INITRD_EXT2 = $(if $(CVWSOC_USE_EXT2),1,0)
CVWSOC_CFG_FW_JUMP_BIN = $(CVWSOC_FW_JUMP_BIN)
CVWSOC_CFG_KERNEL_SRC = $(CVWSOC_LINUX_KERNEL_SRC)
CVWSOC_CFG_INITRD_SRC = $(CVWSOC_LINUX_INITRD_SRC)
CVWSOC_CFG_DTS_SRC = $(CVWSOC_DTS_SRC)
CVWSOC_CFG_BOOTARGS = $(CVWSOC_LINUX_BOOTARGS)
CVWSOC_CFG_QEMU_BIN = $(QEMU_BIN)
CVWSOC_CFG_QEMU_RAM_MB = $(QEMU_RAM_MB)
CVWSOC_CFG_CPU_ARGS = $(CPU_ARGS)
CVWSOC_CFG_GDB_BIN = $(GDB_BIN)
CVWSOC_CFG_OBJCOPY_BIN = $(OBJCOPY_BIN)
CVWSOC_CFG_CVWSOC_XLEN = $(CVWSOC_XLEN)
CVWSOC_CFG_CVWSOC_BUS_WIDTH = $(CVWSOC_BUS_WIDTH)
CVWSOC_CFG_PRELOAD_WORD_BYTES = $(CVWSOC_WORD_BYTES)
CVWSOC_CFG_DTC_BIN = $(DTC_BIN)
CVWSOC_CFG_UNLZ4_BIN = $(UNLZ4_BIN)
CVWSOC_CFG_KERNEL_ADDR = $(CVWSOC_KERNEL_ADDR)
CVWSOC_CFG_UBOOT_ADDR = $(UBOOT_ADDR)
CVWSOC_CFG_UBOOT_STUB_BIN = $(CVWSOC_UBOOT_STUB_BIN)
CVWSOC_CFG_UBOOT_BIN = $(CVWSOC_UBOOT_BIN)
CVWSOC_CFG_UBOOT_DTB = $(CVWSOC_UBOOT_DTB)
CVWSOC_CFG_UBOOT_DTB_ADDR = $(UBOOT_DTB_ADDR)
CVWSOC_CFG_KERNEL_DTB_ADDR = $(KERNEL_DTB_ADDR)
CVWSOC_CFG_INITRD_ADDR = $(INITRD_ADDR)
CVWSOC_CFG_ROOTFS_DTS_SIZE = $(ROOTFS_DTS_SIZE)
CVWSOC_CFG_EXTERNAL_DTB = $(CVWSOC_VERILATOR_DTB)

define WRITE_CVWSOC_CFG
	@tmp="$@.tmp"; \
	{ \
		$(foreach key,$(CVWSOC_CFG_KEYS),printf '%s=%s\n' '$(key)' '$(CVWSOC_CFG_$(key))';) \
	} > "$$tmp"; \
	if ! cmp -s "$$tmp" "$@"; then mv "$$tmp" "$@"; else rm -f "$$tmp"; fi
endef

$(CVWSOC_LINUX_QEMU_CFG): CVWSOC_CFG_KEYS := $(CVWSOC_CFG_QEMU_KEYS)
$(CVWSOC_LINUX_QEMU_CFG): CVWSOC_CFG_MODE := linux
$(CVWSOC_LINUX_QEMU_CFG): CVWSOC_CFG_QEMU_KERNEL := $(CVWSOC_LINUX_QEMU_KERNEL)
$(CVWSOC_LINUX_QEMU_CFG): CVWSOC_CFG_QEMU_INITRD := $(CVWSOC_LINUX_QEMU_INITRD)
$(CVWSOC_LINUX_QEMU_CFG): CVWSOC_CFG_GENERATED_DTS := $(CVWSOC_LINUX_QEMU_DTS)
$(CVWSOC_LINUX_QEMU_CFG): CVWSOC_CFG_GENERATED_DTB := $(CVWSOC_LINUX_QEMU_DTB)
$(CVWSOC_LINUX_QEMU_CFG): FORCE | $(CVWSOC_PRELOAD_DIR)
	$(WRITE_CVWSOC_CFG)

$(CVWSOC_LINUX_FAST_QEMU_CFG): CVWSOC_CFG_KEYS := $(CVWSOC_CFG_FAST_KEYS)
$(CVWSOC_LINUX_FAST_QEMU_CFG): CVWSOC_CFG_MODE := linux-fast
$(CVWSOC_LINUX_FAST_QEMU_CFG): CVWSOC_CFG_ROOTFS_MODE := $(CVWSOC_QEMU_FAST_ROOTFS_MODE)
$(CVWSOC_LINUX_FAST_QEMU_CFG): CVWSOC_CFG_INITRD_SRC := $(CVWSOC_LINUX_FAST_ROOTFS_SRC)
$(CVWSOC_LINUX_FAST_QEMU_CFG): CVWSOC_CFG_BOOTARGS := $(CVWSOC_QEMU_FAST_BOOTARGS)
$(CVWSOC_LINUX_FAST_QEMU_CFG): CVWSOC_CFG_ROOTFS_ADDR := $(CVWSOC_QEMU_FAST_ROOTFS_ADDR)
$(CVWSOC_LINUX_FAST_QEMU_CFG): CVWSOC_CFG_ROOTFS_COMPATIBLE := $(CVWSOC_QEMU_FAST_ROOTFS_COMPATIBLE)
$(CVWSOC_LINUX_FAST_QEMU_CFG): CVWSOC_CFG_ROOTFS_BANK_WIDTH := $(CVWSOC_QEMU_FAST_ROOTFS_BANK_WIDTH)
$(CVWSOC_LINUX_FAST_QEMU_CFG): CVWSOC_CFG_ROOTFS_ERASE_SIZE := $(CVWSOC_QEMU_FAST_ROOTFS_ERASE_SIZE)
$(CVWSOC_LINUX_FAST_QEMU_CFG): CVWSOC_CFG_QEMU_KERNEL := $(CVWSOC_LINUX_FAST_QEMU_KERNEL)
$(CVWSOC_LINUX_FAST_QEMU_CFG): CVWSOC_CFG_QEMU_INITRD := $(CVWSOC_LINUX_FAST_QEMU_ROOTFS)
$(CVWSOC_LINUX_FAST_QEMU_CFG): CVWSOC_CFG_GENERATED_DTS := $(CVWSOC_LINUX_FAST_QEMU_DTS)
$(CVWSOC_LINUX_FAST_QEMU_CFG): CVWSOC_CFG_GENERATED_DTB := $(CVWSOC_LINUX_FAST_QEMU_DTB)
$(CVWSOC_LINUX_FAST_QEMU_CFG): FORCE | $(CVWSOC_PRELOAD_DIR)
	$(WRITE_CVWSOC_CFG)

$(CVWSOC_UBOOT_QEMU_CFG): CVWSOC_CFG_KEYS := $(CVWSOC_CFG_UBOOT_QEMU_KEYS)
$(CVWSOC_UBOOT_QEMU_CFG): CVWSOC_CFG_MODE := uboot
$(CVWSOC_UBOOT_QEMU_CFG): CVWSOC_CFG_QEMU_KERNEL := $(CVWSOC_UBOOT_QEMU_KERNEL)
$(CVWSOC_UBOOT_QEMU_CFG): CVWSOC_CFG_QEMU_INITRD := $(CVWSOC_UBOOT_QEMU_INITRD)
$(CVWSOC_UBOOT_QEMU_CFG): CVWSOC_CFG_GENERATED_DTS := $(CVWSOC_UBOOT_QEMU_DTS)
