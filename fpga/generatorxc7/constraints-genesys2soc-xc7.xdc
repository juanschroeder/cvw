set_property IOSTANDARD LVCMOS33 [get_ports {GPO[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {GPO[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {GPO[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {GPO[4]}]

set_property PACKAGE_PIN W23 [get_ports LED7]
set_property IOSTANDARD LVCMOS33 [get_ports LED7]
set_property PACKAGE_PIN W24 [get_ports LED6]
set_property IOSTANDARD LVCMOS33 [get_ports LED6]
set_property PACKAGE_PIN V26 [get_ports LED5]
set_property IOSTANDARD LVCMOS33 [get_ports LED5]

set_property PACKAGE_PIN Y20 [get_ports UARTSin]
set_property PACKAGE_PIN Y23 [get_ports UARTSout]
set_property IOSTANDARD LVCMOS33 [get_ports UARTSin]
set_property IOSTANDARD LVCMOS33 [get_ports UARTSout]

# Manta debug UART on Genesys 2 PMOD JB.
set_property PACKAGE_PIN V25 [get_ports debugIn]
set_property PACKAGE_PIN W26 [get_ports debugOut]
set_property IOSTANDARD LVCMOS33 [get_ports debugIn]
set_property IOSTANDARD LVCMOS33 [get_ports debugOut]

# SPI-mode SD card socket, matching fpga/constraints/constraints-genesys2soc.xdc.
set_property PACKAGE_PIN V27 [get_ports SDCCS]
set_property IOSTANDARD LVCMOS33 [get_ports SDCCS]
set_property PULLTYPE PULLUP [get_ports SDCCS]
set_property PACKAGE_PIN V24 [get_ports SDCIn]
