# OpenXC7 timing constraints.
create_clock -name clk200 -period 5.000 [get_ports default_200mhz_clk_p]

set_false_path -from [get_ports resetn]
set_false_path -from [get_ports south_reset]

# Do not add SD generated-clock/input-delay guesses here yet. The current
# nextpnr report's limiting path is inside the CPUCLK domain, not the SD pins.
