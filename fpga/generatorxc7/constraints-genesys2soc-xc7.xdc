# Minimal Genesys 2 constraints for the OpenXC7 experiment.
# This is a reduced XDC subset: pins and basic I/O standards only.

set_property PACKAGE_PIN AD12 [get_ports default_200mhz_clk_p]
set_property PACKAGE_PIN AD11 [get_ports default_200mhz_clk_n]
set_property IOSTANDARD LVDS [get_ports default_200mhz_clk_p]
set_property IOSTANDARD LVDS [get_ports default_200mhz_clk_n]

# v2: Genesys2 slide switches SW0..SW3, not push buttons.
# set_property PACKAGE_PIN E18 [get_ports {GPI[0]}]
# set_property PACKAGE_PIN M19 [get_ports {GPI[1]}]
# set_property PACKAGE_PIN M20 [get_ports {GPI[2]}]
# set_property PACKAGE_PIN C19 [get_ports {GPI[3]}]
set_property PACKAGE_PIN G19 [get_ports {GPI[0]}]
set_property PACKAGE_PIN G25 [get_ports {GPI[1]}]
set_property PACKAGE_PIN H24 [get_ports {GPI[2]}]
set_property PACKAGE_PIN K19 [get_ports {GPI[3]}]
set_property IOSTANDARD LVCMOS12 [get_ports {GPI[0]}]
set_property IOSTANDARD LVCMOS12 [get_ports {GPI[1]}]
set_property IOSTANDARD LVCMOS12 [get_ports {GPI[2]}]
set_property IOSTANDARD LVCMOS12 [get_ports {GPI[3]}]

set_property PACKAGE_PIN T28 [get_ports {GPO[0]}]
set_property PACKAGE_PIN V19 [get_ports {GPO[1]}]
set_property PACKAGE_PIN U30 [get_ports {GPO[2]}]
set_property PACKAGE_PIN U29 [get_ports {GPO[3]}]
set_property PACKAGE_PIN V20 [get_ports {GPO[4]}]
