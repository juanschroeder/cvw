+// Convert 8bpp paletted Doom screen to RGB565 using lookup table.
+// Optimized to write 4 pixels per 64-bit store when aligned.
+static inline void convert_line_8_to_565(uint16_t *dst, const uint8_t *src, int n)
+{
+    int i = 0;
+
+    // If dst is 8-byte aligned, we can do 4 pixels per store safely.
+    if ((((uintptr_t)dst) & 7u) == 0) {
+        for (; i + 4 <= n; i += 4) {
+            uint64_t v =
+                ((uint64_t) rgb565_palette[src[i + 0]]) |
+                ((uint64_t) rgb565_palette[src[i + 1]] << 16) |
+                ((uint64_t) rgb565_palette[src[i + 2]] << 32) |
+                ((uint64_t) rgb565_palette[src[i + 3]] << 48);
+            *((uint64_t *)(dst + i)) = v;
+        }
+    }
+
+    for (; i < n; i++) {
+        dst[i] = rgb565_palette[src[i]];
+    }
+}
+
+// Copy RGB565 pixels to an fbdev line using 64-bit stores when possible.
+// dst_bytes points inside the (typically uncached) fb mmap region.
+static inline void blit565_line64(uint8_t *dst_bytes, const uint16_t *src565, int n_pixels)
+{
+    size_t nbytes = (size_t)n_pixels * 2u;
+
+    // Fast aligned path (common when fb line_length is 2*xres and x_offset is 0).
+    if ((((uintptr_t)dst_bytes | (uintptr_t)src565) & 7u) == 0 && (nbytes & 7u) == 0) {
+        uint64_t *d = (uint64_t *) dst_bytes;
+        const uint64_t *s = (const uint64_t *) src565;
+        size_t n64 = nbytes / 8u;
+        for (size_t i = 0; i < n64; i++) {
+            d[i] = s[i];
+        }
+        return;
+    }
+
+    // Fallback (still sequential)
+    memcpy(dst_bytes, src565, nbytes);
+}
