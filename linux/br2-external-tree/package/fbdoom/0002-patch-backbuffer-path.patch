-    write(fd_fb, I_VideoBuffer_FB, (SCREENHEIGHT * fb_scaling * (fb.bits_per_pixel/8)) * fb.xres); /* draw only portion used by doom + x-offsets */
+    /* Present to framebuffer */
+    if (fb_map) {
+        // Clear top/bottom borders if any
+        int bytespp = fb.bits_per_pixel/8;
+        int active_h = SCREENHEIGHT * fb_scaling;
+        int active_w_bytes = fb.xres * bytespp;   // we build full-width rows in I_VideoBuffer_FB
+        int y_off_lines = (fb.yres - active_h) / 2;
+        if (y_off_lines < 0) y_off_lines = 0;
+
+        // clear top
+        if (y_off_lines > 0) {
+            memset(fb_map, 0, (size_t)y_off_lines * (size_t)fb_fix.line_length);
+        }
+        // clear bottom
+        int bottom_lines = fb.yres - (y_off_lines + active_h);
+        if (bottom_lines > 0) {
+            memset(fb_map + (size_t)(y_off_lines + active_h) * (size_t)fb_fix.line_length, 0,
+                   (size_t)bottom_lines * (size_t)fb_fix.line_length);
+        }
+
+        // copy active_h lines into mapped fb at y offset
+        size_t copy_lines = (size_t)active_h;
+        size_t src_stride = (size_t)active_w_bytes;
+        size_t dst_stride = (size_t)fb_fix.line_length;
+        size_t to_copy = src_stride;
+        if (to_copy > dst_stride) to_copy = dst_stride;
+
+        for (size_t yy = 0; yy < copy_lines; yy++) {
+            uint8_t *dst = fb_map + ((size_t)y_off_lines + yy) * dst_stride;
+            uint8_t *src = (uint8_t*)I_VideoBuffer_FB + yy * src_stride;
+            memcpy(dst, src, to_copy);
+            // clear any padding at end of line
+            if (dst_stride > to_copy) memset(dst + to_copy, 0, dst_stride - to_copy);
+        }
+
+        __asm__ volatile("fence rw,rw" ::: "memory");
+    } else {
+        /* Fallback to write() */
+        int bytespp = fb.bits_per_pixel/8;
+        int active_h = SCREENHEIGHT * fb_scaling;
+        int y_off_lines = (fb.yres - active_h) / 2;
+        if (y_off_lines < 0) y_off_lines = 0;
+        off_t off = (off_t)y_off_lines * (off_t)fb_fix.line_length;
+        lseek(fd_fb, off, SEEK_SET);
+        write(fd_fb, I_VideoBuffer_FB, (size_t)active_h * (size_t)(fb.xres * bytespp));
+    }
