 void I_FinishUpdate (void)
 {
+    // FAST RGB565 path:
+    // - Convert Doom's 8bpp I_VideoBuffer to a cacheable RGB565 backbuffer
+    // - Burst-copy the result to the (typically uncached) fbdev mmap region
+    // This avoids per-pixel uncached stores.
+    if (fast565 && fb_map && backbuf565) {
+        // Convert 320x200
+        const uint8_t *src = (const uint8_t *) I_VideoBuffer;
+        uint16_t *dst = backbuf565;
+        for (int yy = 0; yy < SCREENHEIGHT; yy++) {
+            convert_line_8_to_565(dst, src, SCREENWIDTH);
+            src += SCREENWIDTH;
+            dst += SCREENWIDTH;
+        }
+
+        // Center Doom's 320x200 inside fb.xres x fb.yres (usually 320x240)
+        int bytespp = 2;
+        int y_off_lines = (int)(fb.yres - SCREENHEIGHT) / 2;
+        if (y_off_lines < 0) y_off_lines = 0;
+
+        int x_off_bytes = (int)(fb.xres - SCREENWIDTH) * bytespp / 2;
+        if (x_off_bytes < 0) x_off_bytes = 0;
+
+        // Clear top/bottom borders (common for 240p)
+        if (y_off_lines > 0) {
+            memset(fb_map, 0, (size_t)y_off_lines * (size_t)fb_fix.line_length);
+        }
+        int bottom_lines = (int)fb.yres - (y_off_lines + SCREENHEIGHT);
+        if (bottom_lines > 0) {
+            memset(fb_map + (size_t)(y_off_lines + SCREENHEIGHT) * (size_t)fb_fix.line_length, 0,
+                   (size_t)bottom_lines * (size_t)fb_fix.line_length);
+        }
+
+        // Copy active area line-by-line
+        for (int yy = 0; yy < SCREENHEIGHT; yy++) {
+            uint8_t *dst_line = fb_map + (size_t)(y_off_lines + yy) * (size_t)fb_fix.line_length + (size_t)x_off_bytes;
+            const uint16_t *src_line = backbuf565 + (size_t)yy * (size_t)SCREENWIDTH;
+
+            blit565_line64(dst_line, src_line, SCREENWIDTH);
+
+            // Clear any padding at end of line (if line_length > xres*2)
+            size_t used = (size_t)x_off_bytes + (size_t)SCREENWIDTH * 2u;
+            if ((size_t)fb_fix.line_length > used) {
+                memset(fb_map + (size_t)(y_off_lines + yy) * (size_t)fb_fix.line_length + used, 0,
+                       (size_t)fb_fix.line_length - used);
+            }
+        }
+
+        __asm__ volatile("fence rw,rw" ::: "memory");
+        return;
+    }
+
     int y;
     int x_offset, y_offset, x_offset_end;
     unsigned char *line_in, *line_out;
