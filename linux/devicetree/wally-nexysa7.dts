/dts-v1/;

/ {
  #address-cells = <0x02>;
  #size-cells = <0x02>;
  compatible = "wally-virt";
  model = "wally-virt,qemu";

  chosen {
    linux,initrd-end = <0x85c43a00>;
    linux,initrd-start = <0x84200000>;
    bootargs = "root=/dev/vda ro  console=ttyS0,115200 loglevel=7";
    stdout-path = "/soc/uart@10000000";
  };

  memory@80000000 {
    device_type = "memory";
    reg = <0x00 0x80000000 0x00 0x8000000>;
  };

  cpus {
    #address-cells = <0x01>;
    #size-cells = <0x00>;
    clock-frequency = <20000000>;
    timebase-frequency = <20000000>;

    cpu@0 {
      phandle = <0x01>;
      device_type = "cpu";
      reg = <0x00>;
      status = "okay";
      compatible = "riscv";
      riscv,isa-base = "rv64i";
      riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "sstc", "svade", "svadu", "svinval", "svnapot", "svpbmt", "zba", "zbb", "zbc", "zbs", "zca", "zcb", "zcd", "zfa", "zfh", "zkn", "zkt", "zicbom", "zicboz", "zicntr", "zicond", "zicsr", "zifencei", "zihpm";
      riscv,cboz-block-size = <64>;
      riscv,cbom-block-size = <64>;
      mmu-type = "riscv,sv48";

      interrupt-controller {
        #interrupt-cells = <0x01>;
        interrupt-controller;
        compatible = "riscv,cpu-intc";
        phandle = <0x02>;
      };
    };
  };

  soc {
    #address-cells = <0x02>;
    #size-cells = <0x02>;
    compatible = "simple-bus";
    ranges;

    refclk: refclk {
      #clock-cells = <0>;
      compatible = "fixed-clock";
      clock-frequency = <20000000>;
      clock-output-names = "xtal";
    };

    gpio0: gpio@10060000 {
      compatible = "sifive,gpio0";
      interrupt-parent = <0x03>;
      interrupts = <3>;
      reg = <0x00 0x10060000 0x00 0x1000>;
      reg-names = "control";
      gpio-controller;
      #gpio-cells = <2>;
      interrupt-controller;
      #interrupt-cells = <2>;
    };

    uart@10000000 {
      interrupts = <0x0a>;
      interrupt-parent = <0x03>;
      clock-frequency = <20000000>;
      reg = <0x00 0x10000000 0x00 0x100>;
      compatible = "ns16550a";
    };

    plic: plic@c000000 {
      phandle = <0x03>;
      riscv,ndev = <0x35>;
      reg = <0x00 0xc000000 0x00 0x210000>;
      interrupts-extended = <0x02 0x0b 0x02 0x09>;
      interrupt-controller;
      compatible = "sifive,plic-1.0.0\0riscv,plic0";
      #interrupt-cells = <0x01>;
      #address-cells = <0x00>;
    };

    spi@13000 {
      compatible = "sifive,spi0";
      interrupt-parent = <0x03>;
      interrupts = <0x14>;
      reg = <0x0 0x13000 0x0 0x1000>;
      reg-names = "control";
      clocks = <&refclk>;

      #address-cells = <1>;
      #size-cells = <0>;
      mmc@0 {
        compatible = "mmc-spi-slot";
        reg = <0>;
        spi-max-frequency = <1000000>;
        voltage-ranges = <3300 3300>;
        disable-wp;
        // gpios = <&gpio0 6 1>;
      };
    };

    clint@2000000 {
      interrupts-extended = <0x02 0x03 0x02 0x07>;
      reg = <0x00 0x2000000 0x00 0x10000>;
      compatible = "sifive,clint0\0riscv,clint0";
    };

    // Wishbone stuff ---------------
    uart1: uart@11004000 {
        compatible = "ns16550a";
        reg = <0x0 0x11004000 0x0 0x1000>;

        interrupt-parent = <0x03>;
        interrupts = <0x0b>; // 11

        clock-frequency = <200000000>;
        reg-shift = <0>;
        reg-io-width = <1>;

        status = "okay";
    };

    eth0: ethernet@11003000 {
        compatible = "litex,liteeth";

        reg = <0x0 0x11003000 0x0 0x100>,   // mac  (csr+0x1000) 
                <0x0 0x11002800 0x0 0x100>,   // mdio (csr+0x0800)
                <0x0 0x11000000 0x0 0x2000>;  // buffer 
        reg-names = "mac", "mdio", "buffer";

        interrupt-parent = <0x03>;
        interrupts = <0xC>;

        litex,rx-slots  = <2>;
        litex,tx-slots  = <2>;
        litex,slot-size = <0x800>;

        phy-handle = <&ethphy0>;
        status = "okay";

        mdio {
            #address-cells = <1>;
            #size-cells = <0>;

            ethphy0: ethernet-phy@0 {
                reg = <0>; // <-- set to your PHY strap addr if not 0
            };
        };

    };
    //---------------------------------------------

    busclk: busclk {
      #clock-cells = <0>;
      compatible = "fixed-clock";
      // Clock      Period(ns)  Waveform(ns)   Attributes  Sources
      // clk_pll_i  12.308      {0.000 6.154}  P,G,A       {ddr2/u_ddr2_mig/u_ddr2_infrastructure/gen_mmcm.mmcm_i/CLKFBOUT}
      clock-frequency = <81250000>; //This is the speed of signal 'ddr2/ui_clk' (DDR2 block OUTPUT, 12.308 ns)
      clock-output-names = "busclk";
    };

    cdma0: dma@100A0000 {
        compatible = "xlnx,axi-cdma-1.00.a";
        //reg = <0x100A0000 0x1000>;
        reg = <0x0 0x100A0000 0x0 0x1000>;

        #dma-cells = <1>;
        xlnx,addrwidth = <0x20>;              /* 32-bit addresses */
        status = "okay";

        /*
        * DMA visible memory window.
        * For your 128MB DDR at 0x8000_0000..0x87FF_FFFF:
        */
        //dma-ranges = <0x80000000 0x80000000 0x08000000>;
        //dma-ranges = <0x0 0x80000000  0x0 0x80000000  0x08000000>;

        clock-names = "s_axi_lite_aclk", "m_axi_aclk", "axi_aclk";
        clocks = <&busclk>, <&busclk>, <&busclk>;

        // Mark non-coherent
        dma-noncoherent;

        interrupt-parent = <&plic>;           /* replace with your real interrupt controller phandle */
        interrupts = <13>;              /* replace with the PLIC source number you wired */

        dma-channel@100A0000 {
            compatible = "xlnx,axi-cdma-channel";
            interrupts = <13>;
            xlnx,datawidth = <0x40>;          /* 64-bit datapath (common to keep consistent) */
            xlnx,device-id = <0>;
            xlnx,max-burst-len = <0x10>;
        };
    };


    //---------------------------------------------    
  };

    reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        framebuffer@87E00000 {
            reg = <0x0 0x87E00000 0x0 0x00096000>; // 640 KiB reserved
            no-map;
        };
        dmabuffer@87F00000 {
            compatible = "shared-dma-pool"; // for later DMA use
            reg = <0x0 0x87F00000 0x0 0x00100000>; // 1 MiB reserved
            no-map;
        };
    };
    



};


//---------------------------------------------
// VGA stuff

/ {
    /*
    //640x480
    framebuffer0: framebuffer@87e00000 {
        compatible = "simple-framebuffer";
        reg = <0x0 0x87E00000 0x0 0x00096000>;
        width = <640>;
        height = <480>;
        stride = <1280>;  // 640 * 2
        format = "r5g6b5";
    };
     */
    //320 x 240
    framebuffer0: framebuffer@87e00000 {
        compatible = "simple-framebuffer";
        reg = <0x0 0x87E00000 0x0 0x00025800>;
        width = <320>;
        height = <240>;
        stride = <640>;  // 320 * 2
        format = "r5g6b5";
    };

};
